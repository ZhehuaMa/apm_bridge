# Restart with: sudo systemctl restart apm-bridge
FC_PORT=/dev/ttyS8
LINK_BAUD=921600
GIMBAL_PORT=/dev/ttyS10
GIMBAL_MODEL=C20S
ROS_DOMAIN_ID=0
# Set true only for an approved captive rig; sets enabled AND rig_confirmed together.
BENCH_PID_ENABLED=false
# Use GIMBAL_PORT="" when no gimbal is connected.
# Override parameters with APM_CONFIG and APM_BENCH_CONFIG (absolute paths).
